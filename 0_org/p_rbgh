FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rbgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    bottom
    {
        // fixedFluxPressure: correct BC for solid walls in buoyant solvers.
        // zeroGradient causes hydrostatic pressure decoupling near bed.
        type            fixedFluxPressure;
        value           uniform 0;
    }
    top
    {
        type            slip;
    }
    bridge
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}
