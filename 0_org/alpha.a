FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.a;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        // zeroGradient: packed bed (alpha=0.60) is set by setFields at t=0.
        // Do NOT re-inject fixed alpha at inlet — this was causing a packing
        // singularity at the inlet face driving alpha.a -> alphaMax each step.
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottom
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    bridge
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}
