FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     sedFoam_rbgh;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         60;

deltaT          1e-5;   // very conservative startup - allows bed to settle before shockwaves

writeControl    adjustableRunTime;

writeInterval   1;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable on;

adjustTimeStep  true;

maxCo           0.9;    // Aggressive limit for sedFoam_rbgh (ref: sedExnerFoam uses 2.0)

maxAlphaCo      0.9;    // Aggressive phase Courant limit

maxDeltaT       2e-3;   // 2ms ceiling - 10x faster than conservative 2e-4

// ************************************************************************* //
