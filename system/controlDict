FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     sedFoam_rbgh;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         60;

deltaT          1e-5;   // very conservative startup - allows bed to settle before shockwaves

writeControl    adjustableRunTime;

writeInterval   1;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable on;

adjustTimeStep  true;

maxCo           0.5;    // Optimal sweet spot for sedFoam_rbgh with packingLimiter

maxAlphaCo      0.5;    // Optimal sweet spot for phase Courant

maxDeltaT       5e-4;   // 0.5ms - best stable throughput for this mesh

// ************************************************************************* //
