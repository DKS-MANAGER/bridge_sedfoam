FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     sedFoam_rbgh;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         60;

deltaT          1e-5;   // very conservative startup - allows bed to settle before shockwaves

writeControl    adjustableRunTime;

writeInterval   1;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable on;

adjustTimeStep  true;

maxCo           1.2;    // Fluid Courant limit - matched to 3DScour case

maxAlphaCo      1.0;    // Phase fraction Courant limit - matched to 3DScour case

maxDeltaT       5e-2;   // 50ms ceiling - matched to 3DScour case

// ************************************************************************* //
