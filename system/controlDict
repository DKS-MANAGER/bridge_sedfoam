FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     sedFoam_rbgh;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         60;

deltaT          1e-5;   // very conservative startup - allows bed to settle before shockwaves

writeControl    adjustableRunTime;

writeInterval   1;

purgeWrite      10;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable on;

adjustTimeStep  true;

maxCo           0.3;    // Fluid Courant limit - restored for ultra-fine mesh stability

maxAlphaCo      0.3;    // Phase fraction Courant limit - restored for stability

maxDeltaT       2e-4;   // Restored ceiling to 0.2ms to match sub-millimeter mesh spacing

// ************************************************************************* //
