FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains 8;

method          scotch;

scotchCoeffs
{
    processorWeights (1 1 1 1 1 1 1 1);
}

hierarchicalCoeffs
{
    n               (4 2 1);  // 4 slices in X, 2 vertical layers in Y
    delta           0.001;
    order           xyz;
}

simpleCoeffs
{
    n               (8 1 1);  // 8 streamwise slices along flume length
    delta           0.001;
}

distributed     no;

roots           ( );


